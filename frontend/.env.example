VITE_API_URL=http://localhost:8000

# Google Identity Services client ID. Without this, the Google login button
# on the Login/Signup screens shows a disabled placeholder instead of a real
# button. Register an OAuth client at https://console.cloud.google.com/apis/credentials
# (Web application, add http://localhost:5173 as an authorized origin) and
# paste the client ID here — it must match GOOGLE_CLIENT_ID in the backend's .env.
VITE_GOOGLE_CLIENT_ID=
