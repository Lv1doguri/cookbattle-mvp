DATABASE_URL=sqlite:///./cookbattle.db
JWT_SECRET=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
# 쉼표로 구분. 개발 중에는 * 로 두면 됩니다.
CORS_ORIGINS=*
# Google 로그인. https://console.cloud.google.com 에서 OAuth 클라이언트(웹 애플리케이션) 발급
GOOGLE_CLIENT_ID=
# 쉼표로 구분된 이메일. 이 이메일로 가입하면 자동으로 관리자(is_admin)가 돼요.
# 관리자는 /admin/battles/{id}/phase, /admin/battles/{id}/close 로 대결을 시연용으로 즉시 넘길 수 있어요.
ADMIN_EMAILS=admin@test.com

# 대결 참가 시 "구도 인증" 사진 판정에 쓰는 Claude Vision API 키.
# https://console.anthropic.com 에서 발급. 비워두면 판정을 건너뛰고 항상 통과시켜요(로컬 개발/데모용).
ANTHROPIC_API_KEY=
