DATABASE_URL=sqlite:///./cookbattle.db
# 비워 두면 backend/.jwt_secret 에 랜덤 키 자동 생성 (추천)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
TIMEZONE=Asia/Seoul
# 쉼표로 구분. 이 이메일로 가입하면 관리자 (대결 수동 종료, 상품 등록 등)
# ⚠️ 인터넷에 공개하는 서버에선 비워 두고 `python -m app.make_admin 이메일` 사용
ADMIN_EMAILS=admin@test.com

# 이미지 인식 AI (Claude Vision) — https://console.anthropic.com 에서 키 발급
# 비워 두면 AI 검사 없이 동작 (기본 사진 검사만)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# off: 끔 / advisory: 결과만 기록 / strict: 문제 있으면 참가 거절
AI_CHECK_MODE=strict

# 배포 시 프론트 주소로 제한 (쉼표 구분). 로컬 개발은 *
CORS_ORIGINS=*
